{
  "$defs": {
    "AnswerEvent": {
      "additionalProperties": false,
      "properties": {
        "detail_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail Ref"
        },
        "disposition": {
          "default": "include",
          "enum": [
            "include",
            "exclude_score",
            "quarantine_event"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "material_id": {
          "title": "Material Id",
          "type": "string"
        },
        "max_score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Score"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "selected_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Record Id"
        },
        "selected_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Revision"
        },
        "source_event_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Event Key"
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "status": {
          "enum": [
            "graded",
            "pending",
            "unanswered"
          ],
          "title": "Status",
          "type": "string"
        },
        "student_id": {
          "title": "Student Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "student_id",
        "node_id",
        "material_id",
        "status"
      ],
      "title": "AnswerEvent",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "assessment_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessment Date"
        },
        "available_question_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Question Ids"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "scope_kind": {
          "default": "assessment",
          "enum": [
            "assessment",
            "learning_current"
          ],
          "title": "Scope Kind",
          "type": "string"
        },
        "topic_ids": {
          "items": {
            "type": "string"
          },
          "title": "Topic Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "Node",
      "type": "object"
    },
    "QualityIssue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "retain",
            "exclude_score",
            "quarantine_event",
            "block_import"
          ],
          "title": "Action",
          "type": "string"
        },
        "affected_metric_names": {
          "items": {
            "type": "string"
          },
          "title": "Affected Metric Names",
          "type": "array"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRowRef"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "action",
        "rule_version"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "SourceManifest": {
      "additionalProperties": false,
      "properties": {
        "data_origin": {
          "default": "official",
          "title": "Data Origin",
          "type": "string"
        },
        "dataset_family_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Family Id"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "parent_dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Dataset Id"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "table_row_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Table Row Counts",
          "type": "object"
        }
      },
      "required": [
        "dataset_id",
        "table_row_counts",
        "synthetic"
      ],
      "title": "SourceManifest",
      "type": "object"
    },
    "SourceRecord": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Payload",
          "type": "object"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "source_row_number": {
          "minimum": 1,
          "title": "Source Row Number",
          "type": "integer"
        },
        "table_name": {
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "table_name",
        "source_row_number",
        "payload"
      ],
      "title": "SourceRecord",
      "type": "object"
    },
    "SourceRowRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Id"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "source_row_number": {
          "minimum": 1,
          "title": "Source Row Number",
          "type": "integer"
        },
        "table_name": {
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "table_name",
        "source_row_number"
      ],
      "title": "SourceRowRef",
      "type": "object"
    },
    "Student": {
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "title": "Class Id",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "student_id": {
          "title": "Student Id",
          "type": "string"
        },
        "student_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Uid"
        }
      },
      "required": [
        "student_id",
        "class_id"
      ],
      "title": "Student",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "quality_issues": {
      "items": {
        "$ref": "#/$defs/QualityIssue"
      },
      "title": "Quality Issues",
      "type": "array"
    },
    "raw_records": {
      "items": {
        "$ref": "#/$defs/SourceRecord"
      },
      "title": "Raw Records",
      "type": "array"
    },
    "selected_events": {
      "items": {
        "$ref": "#/$defs/AnswerEvent"
      },
      "title": "Selected Events",
      "type": "array"
    },
    "source_manifest": {
      "$ref": "#/$defs/SourceManifest"
    },
    "students": {
      "items": {
        "$ref": "#/$defs/Student"
      },
      "title": "Students",
      "type": "array"
    }
  },
  "required": [
    "students",
    "nodes",
    "raw_records",
    "selected_events",
    "quality_issues",
    "source_manifest"
  ],
  "title": "PreparedDataset",
  "type": "object"
}
