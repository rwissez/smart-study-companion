{
  "$defs": {
    "SourceRowRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Id"
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "source_row_number": {
          "minimum": 1,
          "title": "Source Row Number",
          "type": "integer"
        },
        "table_name": {
          "title": "Table Name",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "table_name",
        "source_row_number"
      ],
      "title": "SourceRowRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "retain",
        "exclude_score",
        "quarantine_event",
        "block_import"
      ],
      "title": "Action",
      "type": "string"
    },
    "affected_metric_names": {
      "items": {
        "type": "string"
      },
      "title": "Affected Metric Names",
      "type": "array"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Id"
    },
    "field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "issue_id": {
      "title": "Issue Id",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Record Ids",
      "type": "array"
    },
    "rule_version": {
      "title": "Rule Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRowRef"
      },
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "issue_id",
    "code",
    "severity",
    "message",
    "action",
    "rule_version"
