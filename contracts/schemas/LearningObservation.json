{
  "additionalProperties": false,
  "description": "旧观察事件表；作为 C 策略输入投影，不写第二份原始事件。",
  "properties": {
    "activity_id": {
      "title": "Activity Id",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "answer_submitted",
        "hint_requested",
        "activity_completed",
        "teacher_review"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "hint_level": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hint Level"
    },
    "material_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Id"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "observed_at": {
      "title": "Observed At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Payload",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "enum": [
        "student",
        "teacher",
        "system"
      ],
      "title": "Source",
      "type": "string"
    },
    "student_id": {
      "title": "Student Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "dataset_id",
    "run_id",
    "student_id",
    "node_id",
    "activity_id",
    "event_type",
    "sequence",
    "observed_at",
    "source"
  ],
  "title": "LearningObservation",
  "type": "object"
}
