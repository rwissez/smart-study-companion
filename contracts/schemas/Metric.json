{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum"
          ],
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MetricScope": {
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "indicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Id"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "student_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Id"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "MetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "denominator": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Denominator"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "excluded_event_count": {
      "default": 0,
      "title": "Excluded Event Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric_id": {
      "title": "Metric Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "numerator": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Numerator"
    },
    "scope": {
      "$ref": "#/$defs/MetricScope"
    },
    "unit": {
      "enum": [
        "ratio",
        "count",
        "score"
      ],
      "title": "Unit",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "metric_id",
    "name",
    "value",
    "numerator",
    "denominator",
    "unit",
    "scope",
    "evidence_refs"
  ],
  "title": "Metric",
  "type": "object"
}
