{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum"
          ],
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_status": {
      "enum": [
        "sufficient",
        "insufficient",
        "conflicting"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "performance": {
      "enum": [
        "observed_strength",
        "needs_practice",
        "undetermined"
      ],
      "title": "Performance",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "indicator_id",
    "description",
    "evidence_status",
    "performance",
    "evidence_refs"
  ],
  "title": "Finding",
  "type": "object"
}
