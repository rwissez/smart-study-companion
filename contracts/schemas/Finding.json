{
  "$defs": {
    "DiagnosticDetail": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "DiagnosticDetail",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "统一证据引用。定位字段由服务端补足并校验，不接受任意对象路径。",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "curriculum_type": {
          "anyOf": [
            {
              "enum": [
                "topic",
                "indicator",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Type"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum",
            "knowledge_point",
            "relation",
            "annotation",
            "rubric_point",
            "learning_event",
            "attempt",
            "grade",
            "finding",
            "progress",
            "recommendation",
            "source_page",
            "lesson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "diagnostic_details": {
      "items": {
        "$ref": "#/$defs/DiagnosticDetail"
      },
      "title": "Diagnostic Details",
      "type": "array"
    },
    "error_types": {
      "items": {
        "enum": [
          "foundation_gap",
          "step_error",
          "hint_dependency",
          "transfer_difficulty",
          "other_supported"
        ],
        "type": "string"
      },
      "title": "Error Types",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_status": {
      "enum": [
        "sufficient",
        "insufficient",
        "conflicting"
      ],
      "title": "Evidence Status",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "generation_method": {
      "default": "rule",
      "enum": [
        "rule",
        "model",
        "hybrid",
        "human"
      ],
      "title": "Generation Method",
      "type": "string"
    },
    "indicator_id": {
      "title": "Indicator Id",
      "type": "string"
    },
    "kp_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kp Id"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "performance": {
      "enum": [
        "observed_strength",
        "needs_practice",
        "undetermined"
      ],
      "title": "Performance",
      "type": "string"
    },
    "rubric_focus": {
      "items": {
        "type": "string"
      },
      "title": "Rubric Focus",
      "type": "array"
    },
    "topic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Topic Id"
    }
  },
  "required": [
    "finding_id",
    "indicator_id",
    "description",
    "evidence_status",
    "performance",
    "evidence_refs"
  ],
  "title": "Finding",
  "type": "object"
}
