    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "messages": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ChatMessage"
          },
          "type": "array"
