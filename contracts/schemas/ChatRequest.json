{
  "$defs": {
    "AnalysisContext": {
      "additionalProperties": false,
      "description": "D 旧入口兼容：只在服务端转为 target/run/node。",
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "enum": [
            "student",
            "class"
          ],
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "node_id",
        "subject_type",
        "subject_id"
      ],
      "title": "AnalysisContext",
      "type": "object"
    },
    "ChatMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ChatMessage",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "student",
            "class"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
