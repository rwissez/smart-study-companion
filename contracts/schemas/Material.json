      "title": "Rubric Points",
      "type": "array"
    },
    "source_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Label"
    },
    "source_locator": {
      "$ref": "#/$defs/SourceLocator"
    },
    "topic_ids": {
      "items": {
        "type": "string"
      },
      "title": "Topic Ids",
      "type": "array"
    }
  },
  "required": [
    "material_id",
    "material_type",
    "topic_ids",
    "indicator_ids",
    "content",
