{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "统一证据引用。定位字段由服务端补足并校验，不接受任意对象路径。",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "curriculum_type": {
          "anyOf": [
            {
              "enum": [
                "topic",
                "indicator",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Type"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum",
            "knowledge_point",
            "relation",
            "annotation",
            "rubric_point",
            "learning_event",
            "attempt",
            "grade",
            "finding",
            "progress",
            "recommendation",
            "source_page",
            "lesson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MetricScope": {
      "additionalProperties": false,
      "description": "恰好一个 student_id 或 class_id；粒度以最具体字段识别。",
      "properties": {
        "class_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "indicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Id"
        },
        "kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kp Id"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "student_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Id"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "MetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_analysis_version": {
      "title": "Baseline Analysis Version",
      "type": "string"
    },
    "baseline_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Value"
    },
    "classification": {
      "enum": [
        "improved",
        "partially_improved",
        "unchanged_or_declined",
        "insufficient"
      ],
      "title": "Classification",
      "type": "string"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "comparison_id": {
      "title": "Comparison Id",
      "type": "string"
    },
    "current_analysis_version": {
      "title": "Current Analysis Version",
      "type": "string"
    },
    "current_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Value"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/MetricScope"
    },
    "student_id": {
      "title": "Student Id",
      "type": "string"
    }
  },
  "required": [
    "comparison_id",
    "student_id",
    "baseline_analysis_version",
    "current_analysis_version",
    "scope",
    "classification",
    "comparable"
  ],
  "title": "ProgressComparison",
  "type": "object"
}
