{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "统一证据引用。定位字段由服务端补足并校验，不接受任意对象路径。",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "curriculum_type": {
          "anyOf": [
            {
              "enum": [
                "topic",
                "indicator",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Type"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum",
            "knowledge_point",
            "relation",
            "annotation",
            "rubric_point",
            "learning_event",
            "attempt",
            "grade",
            "finding",
            "progress",
            "recommendation",
            "source_page",
            "lesson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "activity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity Id"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recommendation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation Id"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft_hash": {
      "title": "Draft Hash",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "preview_id": {
      "title": "Preview Id",
      "type": "string"
    },
    "warning_digest": {
      "title": "Warning Digest",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "preview_id",
    "draft_hash",
    "warning_digest",
    "expires_at"
  ],
  "title": "TeacherPreview",
  "type": "object"
}
