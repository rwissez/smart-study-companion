{
  "$defs": {
    "AnalysisInputRef": {
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "title": "Catalog Version",
          "type": "string"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "created_at": {
          "default": "",
          "title": "Created At",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "event_cutoff": {
          "minimum": 0,
          "title": "Event Cutoff",
          "type": "integer"
        },
        "included_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Included Event Ids",
          "type": "array"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "catalog_version",
        "rule_version",
        "config_hash",
        "event_cutoff"
      ],
      "title": "AnalysisInputRef",
      "type": "object"
    },
    "AttentionStudent": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "student_id": {
          "title": "Student Id",
          "type": "string"
        }
      },
      "required": [
        "student_id",
        "reason"
      ],
      "title": "AttentionStudent",
      "type": "object"
    },
    "DiagnosticDetail": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "DiagnosticDetail",
      "type": "object"
    },
    "DistributionBucket": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "evidence_status": {
          "enum": [
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "indicator_id": {
          "title": "Indicator Id",
          "type": "string"
        },
        "kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kp Id"
        },
        "performance": {
          "enum": [
            "observed_strength",
            "needs_practice",
            "undetermined"
          ],
          "title": "Performance",
          "type": "string"
        },
        "roster_count": {
          "minimum": 0,
          "title": "Roster Count",
          "type": "integer"
        }
      },
      "required": [
        "indicator_id",
        "performance",
        "evidence_status",
        "count",
        "roster_count"
      ],
      "title": "DistributionBucket",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "统一证据引用。定位字段由服务端补足并校验，不接受任意对象路径。",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "curriculum_type": {
          "anyOf": [
            {
              "enum": [
                "topic",
                "indicator",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Type"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum",
            "knowledge_point",
            "relation",
            "annotation",
            "rubric_point",
            "learning_event",
            "attempt",
            "grade",
            "finding",
            "progress",
            "recommendation",
            "source_page",
            "lesson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "diagnostic_details": {
          "items": {
            "$ref": "#/$defs/DiagnosticDetail"
          },
          "title": "Diagnostic Details",
          "type": "array"
        },
        "error_types": {
          "items": {
            "enum": [
              "foundation_gap",
              "step_error",
              "hint_dependency",
              "transfer_difficulty",
              "other_supported"
            ],
            "type": "string"
          },
          "title": "Error Types",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "generation_method": {
          "default": "rule",
          "enum": [
            "rule",
            "model",
            "hybrid",
            "human"
          ],
          "title": "Generation Method",
          "type": "string"
        },
        "indicator_id": {
          "title": "Indicator Id",
          "type": "string"
        },
        "kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kp Id"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "performance": {
          "enum": [
            "observed_strength",
            "needs_practice",
            "undetermined"
          ],
          "title": "Performance",
          "type": "string"
        },
        "rubric_focus": {
          "items": {
            "type": "string"
          },
          "title": "Rubric Focus",
          "type": "array"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        }
      },
      "required": [
        "finding_id",
        "indicator_id",
        "description",
        "evidence_status",
        "performance",
        "evidence_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "calculation_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Version"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "anyOf": [
            {
              "enum": [
                "sufficient",
                "insufficient",
                "conflicting"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Status"
        },
        "excluded_event_count": {
          "default": 0,
          "title": "Excluded Event Count",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "scope": {
          "$ref": "#/$defs/MetricScope"
        },
        "unit": {
          "enum": [
            "ratio",
            "count",
            "score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "name",
        "value",
        "numerator",
        "denominator",
        "unit",
        "scope",
        "evidence_refs"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricScope": {
      "additionalProperties": false,
      "description": "恰好一个 student_id 或 class_id；粒度以最具体字段识别。",
      "properties": {
        "class_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "indicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Id"
        },
        "kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kp Id"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "student_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Id"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "MetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisInputRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "analysis_version": {
      "default": "",
      "title": "Analysis Version",
      "type": "string"
    },
    "attention_students": {
      "items": {
        "$ref": "#/$defs/AttentionStudent"
      },
      "title": "Attention Students",
      "type": "array"
    },
    "catalog_version": {
      "title": "Catalog Version",
      "type": "string"
    },
    "class_id": {
      "title": "Class Id",
      "type": "string"
    },
    "common_findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Common Findings",
      "type": "array"
    },
    "dataset_family_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Family Id"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "member_analysis_versions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Member Analysis Versions",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "node_id": {
      "title": "Node Id",
      "type": "string"
    },
    "observed_student_count": {
      "title": "Observed Student Count",
      "type": "integer"
    },
    "performance_distribution": {
      "items": {
        "$ref": "#/$defs/DistributionBucket"
      },
      "title": "Performance Distribution",
      "type": "array"
    },
    "publication_status": {
      "default": "unpublished",
      "enum": [
        "unpublished",
        "published",
        "superseded"
      ],
      "title": "Publication Status",
      "type": "string"
    },
    "roster_count": {
      "title": "Roster Count",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    }
  },
  "required": [
    "run_id",
    "dataset_id",
    "catalog_version",
    "class_id",
    "node_id",
    "roster_count",
    "observed_student_count",
    "metrics",
    "findings",
    "limitations"
  ],
  "title": "ClassResult",
  "type": "object"
}
