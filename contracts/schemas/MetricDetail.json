{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "统一证据引用。定位字段由服务端补足并校验，不接受任意对象路径。",
      "properties": {
        "analysis_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Version"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt Id"
        },
        "catalog_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Version"
        },
        "curriculum_type": {
          "anyOf": [
            {
              "enum": [
                "topic",
                "indicator",
                "source"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curriculum Type"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "record",
            "metric",
            "material",
            "curriculum",
            "knowledge_point",
            "relation",
            "annotation",
            "rubric_point",
            "learning_event",
            "attempt",
            "grade",
            "finding",
            "progress",
            "recommendation",
            "source_page",
            "lesson"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Version"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "calculation_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Version"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "anyOf": [
            {
              "enum": [
                "sufficient",
                "insufficient",
                "conflicting"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Status"
        },
        "excluded_event_count": {
          "default": 0,
          "title": "Excluded Event Count",
          "type": "integer"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "scope": {
          "$ref": "#/$defs/MetricScope"
        },
        "unit": {
          "enum": [
            "ratio",
            "count",
            "score"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "name",
        "value",
        "numerator",
        "denominator",
        "unit",
        "scope",
        "evidence_refs"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricScope": {
      "additionalProperties": false,
      "description": "恰好一个 student_id 或 class_id；粒度以最具体字段识别。",
      "properties": {
        "class_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Class Id"
        },
        "indicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Id"
        },
        "kp_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kp Id"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "student_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Id"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Id"
        }
      },
      "required": [
        "node_id"
      ],
      "title": "MetricScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calculation_description": {
      "default": "",
      "title": "Calculation Description",
      "type": "string"
    },
    "evidence_count": {
      "default": 0,
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "excluded_count": {
      "default": 0,
      "minimum": 0,
      "title": "Excluded Count",
      "type": "integer"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    },
    "record_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Record Refs",
      "type": "array"
    }
  },
  "required": [
    "metric"
  ],
  "title": "MetricDetail",
  "type": "object"
}
