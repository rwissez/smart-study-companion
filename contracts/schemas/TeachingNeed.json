        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "evidence_status": {
      "default": "insufficient",
      "title": "Evidence Status",
      "type": "string"
    },
    "feature_values": {
      "items": {
        "type": "number"
      },
