    "priority": {
      "default": 0.0,
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Priority",
      "type": "number"
    },
    "signal_ids": {
      "items": {
        "type": "string"
      },
      "title": "Signal Ids",
      "type": "array"
    },
    "target_key": {
      "title": "Target Key",
      "type": "string"
    },
    "waiting_rounds": {
      "default": 0,
      "title": "Waiting Rounds",
      "type": "integer"
    }
  },
  "required": [
    "target_key",
    "indicator_id",
    "primary_strategy"
  ],
  "title": "TeachingNeed",
  "type": "object"
