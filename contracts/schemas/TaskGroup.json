      "title": "Strategy Types",
      "type": "array"
    },
    "student_intro": {
      "default": "",
      "title": "Student Intro",
      "type": "string"
    },
    "teacher_reason": {
      "default": "",
      "title": "Teacher Reason",
      "type": "string"
