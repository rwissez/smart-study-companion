{
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "description": "学习活动。旧字段全部保留；新字段用于正式新方案。",
      "properties": {
        "activity_id": {
          "default": "",
          "title": "Activity Id",
          "type": "string"
        },
        "activity_kind": {
          "default": "question",
          "enum": [
            "question",
            "study_material",
            "micro_lesson"
          ],
          "title": "Activity Kind",
          "type": "string"
        },
        "content_ref": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "official_card": "#/$defs/OfficialCardRef",
                  "personalized": "#/$defs/PersonalizedRef",
                  "verified_textbook": "#/$defs/VerifiedTextbookRef"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/OfficialCardRef"
                },
                {
                  "$ref": "#/$defs/VerifiedTextbookRef"
                },
                {
                  "$ref": "#/$defs/PersonalizedRef"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Ref"
        },
        "content_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Version"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "estimate_minutes": {
          "default": 4,
          "maximum": 12,
          "minimum": 1,
          "title": "Estimate Minutes",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_outcome": {
          "default": "",
          "title": "Expected Outcome",
          "type": "string"
        },
        "exposure_mode": {
          "anyOf": [
            {
              "enum": [
                "practice",
                "independent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure Mode"
        },
        "group_id": {
          "default": "",
          "title": "Group Id",
          "type": "string"
        },
        "hint_levels": {
          "items": {
            "type": "string"
          },
          "title": "Hint Levels",
          "type": "array"
        },
        "knowledge_ids": {
          "items": {
            "type": "string"
          },
          "title": "Knowledge Ids",
          "type": "array"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "observation_points": {
          "items": {
            "type": "string"
          },
          "title": "Observation Points",
          "type": "array"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "previously_attempted": {
          "default": false,
          "title": "Previously Attempted",
          "type": "boolean"
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "repeat_reason": {
          "anyOf": [
            {
              "enum": [
                "error_retry",
                "independence_check",
                "spaced_review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Reason"
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        },
        "state": {
          "default": "not_started",
          "enum": [
            "not_started",
            "in_progress",
            "completed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "order"
      ],
      "title": "Activity",
      "type": "object"
    },
    "AdjustmentCondition": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "default": "advance",
          "enum": [
            "advance",
            "fall_back",
            "escalate_teacher",
            "wrap_up"
