# 本地运行配置模板。复制为 .env 后按需修改；.env 不会进入 Git。

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
APP_ENV=development
# 本地模拟身份入口（教师/学生选择）。与前端数据来源（VITE_DATA_SOURCE）是两件事：
# DEMO_MODE 只决定能否用本地身份选择，不决定读真实数据还是预设数据。
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/app.sqlite3
DATA_ROOT=./data
OUTPUT_ROOT=./outputs

# 后台任务执行器：1 表示进程内启动单线程 worker；测试/CLI 可设为 0 后手动 drain。
JOBS_WORKER_ENABLED=1
JOBS_IDLE_SECONDS=0.8

# 上传限制
MAX_UPLOAD_BYTES=33554432
MAX_UPLOAD_FILES=12
MAX_IMPORT_ROWS=200000

# ---------------------------------------------------------------------------
# 模型接入（可选）
# ---------------------------------------------------------------------------
# 三项（PROVIDER/BASE_URL/NAME）同时填写才会启用模型适配器；留空时所有需要模型的
# 任务返回 503 MODEL_NOT_CONFIGURED，系统按各自降级策略给出规则结果或"待复核"，
# 不会伪造模型输出。密钥只放在本机 .env 或后端设置里，不进日志、不进导出、不进 Git。
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45

# 赛事材料外发策略：默认关闭。确认赛方允许后，且只发送必要内容时才可开启。
ALLOW_EXTERNAL_MODEL_INPUT=false

# ---------------------------------------------------------------------------
# 前端（frontend/.env.local）
# ---------------------------------------------------------------------------
# VITE_DATA_SOURCE=api
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
