# 本地开发配置模板。复制为 .env 后按需修改；.env 不会进入 Git。
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/app.sqlite3
DATA_ROOT=./data
OUTPUT_ROOT=./outputs

# 模型接入：默认未配置，可选接入。
# 四项同时填写后才会启用模型适配器；留空时所有模型对话返回 503 MODEL_NOT_CONFIGURED。
# 密钥只放在本文件（.env）和演示机上，不要提交、不要写进日志、不要发给队友。
MODEL_PROVIDER=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
